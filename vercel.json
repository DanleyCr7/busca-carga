{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "framework": null,
  "installCommand": "pnpm install",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/cobertura",
      "destination": "/cobertura.html"
    },
    {
      "source": "/motoristas",
      "destination": "/motoristas.html"
    },
    {
      "destination": "/index.html",
      "source": "/(.*)"
    }
  ]
}
